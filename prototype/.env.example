DASHSCOPE_API_KEY=replace_with_your_dashscope_key
DEEPSEEK_API_KEY=replace_with_your_deepseek_key

# Optional. 阿里百炼录音文件识别需要云端可访问的音频 URL。
# 本地 localhost 不能被百炼访问；正式接入时请配置 OSS、内网穿透或部署后的 HTTPS 域名。
PUBLIC_BASE_URL=https://your-public-domain.example.com

# Optional
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_AUDIO_MODEL=qwen-audio-turbo-latest
HOST=127.0.0.1
PORT=5173
